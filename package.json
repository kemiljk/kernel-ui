{
  "name": "kernel-ui-monorepo",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun run --cwd packages/registry build && bun run --filter '@kernelui-lib/*' build",
    "dev": "bun run --cwd packages/react build && bun scripts/dev.mjs",
    "dev:react": "bun run --cwd packages/react dev",
    "docs:build": "bun run --cwd packages/registry build && bun run --cwd packages/react build && bun run --cwd packages/agent build && bun run --cwd apps/docs build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --cwd packages/react test && bun run --cwd packages/cli test && bun run --cwd packages/agent test",
    "test:select": "node scripts/select-check.mjs",
    "test:motion": "node scripts/disclosure-motion-check.mjs",
    "test:shape": "node scripts/check-shape-pairing.mjs",
    "test:svg": "node scripts/check-svg-size.mjs",
    "test:contrast": "node scripts/check-contrast.mjs",
    "test:parity": "node scripts/check-parity.mjs",
    "test:package": "node scripts/check-package-exports.mjs",
    "test:a11y": "node scripts/check-a11y.mjs",
    "test:agent-bridge": "node scripts/check-agent-bridge.mjs",
    "test:motion:docs": "node scripts/disclosure-docs-check.mjs",
    "test:motion:filmstrip": "node scripts/disclosure-filmstrip.mjs",
    "check:changeset": "node scripts/check-changeset.mjs",
    "registry:check": "bun run --cwd packages/registry check",
    "registry:build": "bun run --cwd packages/registry build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run build && changeset publish",
    "smoke:consumer": "node scripts/smoke-test-consumer.mjs",
    "test:styles-package": "node scripts/check-styles-package.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@changesets/cli": "^3.0.3",
    "playwright": "^1.65.1"
  },
  "overrides": {
    "@astrojs/astro2tsx": "0.1.4",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3"
  }
}

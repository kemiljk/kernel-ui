{
  "name": "@kernelui-lib/elements",
  "version": "1.6.2",
  "description": "Kernel's components as native Custom Elements \u2014 framework-agnostic, light DOM, zero runtime dependencies.",
  "license": "MIT",
  "author": "Karl Koch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kemiljk/kernel-ui.git",
    "directory": "packages/elements"
  },
  "homepage": "https://www.kernelui.com",
  "bugs": "https://github.com/kemiljk/kernel-ui/issues",
  "keywords": [
    "web-components",
    "custom-elements",
    "components",
    "accessibility",
    "design-system",
    "agent-skills",
    "tanstack-intent"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/kernel.css",
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/kernel.css",
    "./styles.layer.css": "./dist/kernel.layer.css",
    "./jsx": {
      "types": "./dist/jsx.d.ts"
    },
    "./custom-elements.json": "./dist/custom-elements.json",
    "./vscode.html-custom-data.json": "./dist/vscode.html-custom-data.json"
  },
  "files": [
    "dist",
    "skills",
    "llms.txt",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": true,
  "dependencies": {
    "@kernelui-lib/styles": "^1.4.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^4.4.0"
  },
  "scripts": {
    "build": "bun run --cwd ../registry build && vite build && node scripts/generate-manifest.mjs",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  }
}

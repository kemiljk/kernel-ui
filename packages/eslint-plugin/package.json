{
  "name": "@kernelui-lib/eslint-plugin",
  "version": "0.1.0",
  "description": "ESLint rules for Kernel UI: catch foreign props, invalid values, missing labels and other mistakes people and coding agents make, with the fix in every message.",
  "license": "MIT",
  "author": "Karl Koch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kemiljk/kernel-ui.git",
    "directory": "packages/eslint-plugin"
  },
  "homepage": "https://www.kernelui.com/agents/",
  "bugs": "https://github.com/kemiljk/kernel-ui/issues",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "kernel",
    "accessibility",
    "react",
    "ai",
    "agents"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run --cwd ../registry build && node scripts/build.mjs",
    "typecheck": "node --check src/index.js && node --check scripts/build.mjs",
    "test": "node scripts/build.mjs && vitest run"
  },
  "devDependencies": {
    "eslint": "^10.16.0",
    "vitest": "^4.1.12"
  }
}

{
  "name": "docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/fetch-github-stars.mjs && NODE_OPTIONS=--max-old-space-size=8192 astro check && astro build && node scripts/generate-markdown.mjs",
    "generate:github-stars": "node scripts/fetch-github-stars.mjs",
    "preview": "astro preview",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 astro check"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.0",
    "@fontsource-variable/lilex": "^5.3.0",
    "@fontsource-variable/stack-sans-text": "^5.3.0",
    "@kernelui-lib/elements": "workspace:*",
    "@kernelui-lib/react": "workspace:*",
    "@kernelui-lib/registry": "workspace:*",
    "@kernelui-lib/styles": "workspace:*",
    "astro": "^7.2.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "node-html-parser": "^9.0.1",
    "typescript": "^5.7.3"
  }

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocsSidebar from "../../components/DocsSidebar.astro";
import ExampleGrid from "../../components/ExampleGrid.astro";
import Example from "../../components/Example.astro";
import UsageMeterDemo from "../../components/demos/UsageMeterDemo";
import UsageMeterPlayground from "../../components/demos/UsageMeterPlayground";
import { UsageMeter } from "@kernelui-lib/react";

const warningSnippet = `<UsageMeter
  label="Context window"
  value={172_000}
  max={200_000}
  high={160_000}
  unit="tokens"
/>`;

const moreIsBetterSnippet = `<UsageMeter
  label="Battery"
  value={82}
  max={100}
  low={20}
  high={50}
  optimum={100}
  formatValue={(value) => \`\${value}%\`}
/>`;
---

<BaseLayout title="Usage Meter" withSidebar>
  <DocsSidebar slot="sidebar" />
  <div class="docs-prose">
    <h1>Usage Meter</h1>
    <p>
      Token, credit or quota usage on a real <code>&lt;meter&gt;</code>,
      the HTML element for "a measurement within a known range". Not a
      <code>&lt;progress&gt;</code>: usage isn't a task heading for
      completion, and <code>&lt;meter&gt;</code>'s <code>low</code>,
      <code>high</code> and <code>optimum</code> attributes already say
      "this much is fine, this much is a warning".
    </p>

    <div class="docs-example">
      <UsageMeterDemo client:visible />
    </div>

    <h2>Bands</h2>
    <p>
      The colour follows the same region algorithm the browser uses for
      <code>&lt;meter&gt;</code>, so it always agrees with what assistive
      tech is told. <code>optimum</code> defaults to <code>min</code>,
      because for usage less is better: above <code>high</code> the bar
      turns to warning, and with <code>low</code> set too, the
      <code>low</code>–<code>high</code> band is the warning and above
      <code>high</code> is danger. A full meter is always danger.
      <code>usageMeterLevel()</code> is exported if you need the same
      answer elsewhere.
    </p>
    <p>
      The native bar is restyled with <code>::-webkit-meter-*</code> and
      <code>::-moz-meter-bar</code>, since there's no standard, unprefixed
      way yet, reading tokens only.
    </p>

    <h2>Examples</h2>
    <ExampleGrid>
      <Example title="Warning" description="Above high, with optimum at the default min." code={warningSnippet}>
        <div style="inline-size: 100%;">
          <UsageMeter label="Context window" value={172_000} max={200_000} high={160_000} unit="tokens" />
        </div>
      </Example>
      <Example title="More is better" description="optimum at max flips the bands." code={moreIsBetterSnippet}>
        <div style="inline-size: 100%;">
          <UsageMeter label="Battery" value={82} max={100} low={20} high={50} optimum={100} formatValue={(value: number) => `${value}%`} />
        </div>
      </Example>
    </ExampleGrid>

    <h2>Playground</h2>
    <p>Toggle every adjustable prop and watch the component — and the code — update live.</p>
    <UsageMeterPlayground client:visible />

    <h2>Props</h2>
    <div class="docs-table-scroll"><table class="docs-table">
      <caption>Props for Usage Meter.</caption>
      <thead><tr><th scope="col">Prop</th><th scope="col">Type</th><th scope="col">Default</th></tr></thead>
      <tbody>
        <tr><td><code>label</code></td><td>ReactNode (required)</td><td>—</td></tr>
        <tr><td><code>hideLabel</code></td><td>boolean</td><td>false</td></tr>
        <tr><td><code>value</code></td><td>number (required)</td><td>—</td></tr>
        <tr><td><code>min</code></td><td>number</td><td>0</td></tr>
        <tr><td><code>max</code></td><td>number (required)</td><td>—</td></tr>
        <tr><td><code>low</code> / <code>high</code></td><td>number</td><td>—</td></tr>
        <tr><td><code>optimum</code></td><td>number</td><td><code>min</code></td></tr>
        <tr><td><code>unit</code></td><td>string</td><td>—</td></tr>
        <tr><td><code>locale</code></td><td>string</td><td>the reader's</td></tr>
        <tr><td><code>formatValue</code></td><td>(value, max) =&gt; string</td><td>"12,340 / 200,000 tokens"</td></tr>
        <tr><td><code>description</code></td><td>ReactNode</td><td>—</td></tr>
        <tr><td><code>className</code> / <code>wrapperClassName</code></td><td>on the meter / the wrapper</td><td>—</td></tr>
      </tbody>
    </table></div>

    <h2>Accessibility</h2>
    <ul>
      <li>The label is a real <code>&lt;label for&gt;</code>: <code>&lt;meter&gt;</code> is a labelable element.</li>
      <li>The formatted text is the meter's <code>aria-valuetext</code>, so it's read with its unit; the visible copy is <code>aria-hidden</code> so it isn't read twice.</li>
      <li>Colour is never the only signal: the value text is always shown.</li>
    </ul>
  </div>
</BaseLayout>

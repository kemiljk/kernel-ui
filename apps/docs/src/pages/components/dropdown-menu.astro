---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocsSidebar from "../../components/DocsSidebar.astro";
import UsageAccordion from "../../components/UsageAccordion.astro";
import DropdownMenuDemo from "../../components/demos/DropdownMenuDemo";
import DropdownMenuPlayground from "../../components/demos/DropdownMenuPlayground";

const usageSnippet = `import { Button, DropdownMenu, MenuChevron, MenuItem, MenuSeparator } from "@kernelui-lib/react";

function ActionsMenu() {
  return (
    <DropdownMenu
      align="end"
      offset={4}
      className="my-menu"
      render={<Button variant="secondary" iconEnd={<MenuChevron />}>Actions</Button>}
    >
      <MenuItem onSelect={() => {}}>Edit</MenuItem>
      <MenuItem render={<a href="/docs" />}>Documentation</MenuItem>
      <MenuSeparator />
      <MenuItem destructive onSelect={() => {}}>
        Delete
      </MenuItem>
    </DropdownMenu>
  );
}`;
---

<BaseLayout title="Dropdown Menu" withSidebar>
  <DocsSidebar slot="sidebar" />
  <div class="docs-prose">
    <h1>Dropdown Menu</h1>
    <p>
      <code>role="menu"</code> on a <code>popover="auto"</code> element.
      Outside-click and Escape dismissal come free from the popover.
      Arrow-key roving between items is the one part of the WAI-ARIA menu
      pattern that has to be wired up by hand, there's no native menu
      element yet.
    </p>

    <div class="docs-example">
      <DropdownMenuDemo client:visible />
    </div>

    <UsageAccordion code={usageSnippet} lang="tsx" />

    <h2>Playground</h2>
    <p>Toggle every adjustable prop and watch the component — and the code — update live.</p>
    <DropdownMenuPlayground client:visible />

    <h2>Props</h2>
    <div class="docs-table-scroll"><table class="docs-table">
      <caption>Props for Dropdown Menu.</caption>
      <thead><tr><th scope="col">Component</th><th scope="col">Prop</th><th scope="col">Type</th></tr></thead>
      <tbody>
        <tr><td><code>DropdownMenu</code></td><td><code>render</code></td><td>the trigger (required)</td></tr>
        <tr><td><code>DropdownMenu</code></td><td><code>renderContent</code></td><td>RenderProp — replace the popup</td></tr>
        <tr><td><code>DropdownMenu</code></td><td><code>className</code></td><td>string | (state) =&gt; string</td></tr>
        <tr><td><code>DropdownMenu</code></td><td><code>placement</code></td><td>"top" | "bottom" | "left" | "right"</td></tr>
        <tr><td><code>DropdownMenu</code></td><td><code>align</code></td><td>"start" | "center" | "end"</td></tr>
        <tr><td><code>DropdownMenu</code></td><td><code>offset</code></td><td>number (px)</td></tr>
        <tr><td><code>MenuItem</code></td><td><code>render</code></td><td>RenderProp — e.g. <code>&lt;a&gt;</code> / router Link</td></tr>
        <tr><td><code>MenuItem</code></td><td><code>className</code></td><td>string | (state) =&gt; string</td></tr>
        <tr><td><code>MenuItem</code></td><td><code>onSelect</code></td><td>() =&gt; void</td></tr>
        <tr><td><code>MenuItem</code></td><td><code>destructive</code></td><td>boolean</td></tr>
        <tr><td><code>MenuChevron</code></td><td>—</td><td>no props — drop into a trigger's <code>iconEnd</code>; rotates via <code>aria-expanded</code></td></tr>
      </tbody>
    </table></div>

    <h2>Accessibility</h2>
    <p>
      Opening moves focus to the first item. Arrow Up/Down, Home, and End
      move between items. Selecting an item, or pressing Escape, closes
      the menu. Link items keep native navigation, modifier-clicks, and
      new-tab behaviour — selection closes the menu without
      <code>preventDefault</code>.
    </p>
  </div>
</BaseLayout>

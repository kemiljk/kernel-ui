---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocsSidebar from "../../components/DocsSidebar.astro";
import ExampleGrid from "../../components/ExampleGrid.astro";
import Example from "../../components/Example.astro";
import SuggestionDemo from "../../components/demos/SuggestionDemo";
import SuggestionPlayground from "../../components/demos/SuggestionPlayground";
import { Suggestion, SuggestionItem } from "@kernelui-lib/react";

const basicSnippet = `<Suggestion>
  <SuggestionItem onSelect={setValue}>Summarise the latest release notes</SuggestionItem>
  <SuggestionItem onSelect={setValue}>Explain this TypeScript error</SuggestionItem>
</Suggestion>`;

const composerSnippet = `<Suggestion>
  {prompts.map((prompt) => (
    <SuggestionItem key={prompt} onSelect={setValue}>{prompt}</SuggestionItem>
  ))}
</Suggestion>
<Composer value={value} onValueChange={setValue} … />`;
---

<BaseLayout title="Suggestion" withSidebar>
  <DocsSidebar slot="sidebar" />
  <div class="docs-prose">
    <h1>Suggestion</h1>
    <p>
      Prompt suggestion chips that seed the next message — a real{" "}
      <code>&lt;ul&gt;</code> of <code>&lt;button&gt;</code>s, meant to sit
      above or below <a href="/components/composer/">Composer</a>.
    </p>

    <div class="docs-example" style="flex-direction: column; align-items: stretch;">
      <SuggestionDemo client:visible />
    </div>

    <h2>Examples</h2>
    <ExampleGrid>
      <Example title="Basic" description="A short list of starter prompts." code={basicSnippet}>
        <Suggestion>
          <SuggestionItem>Summarise the latest release notes</SuggestionItem>
          <SuggestionItem>Explain this TypeScript error</SuggestionItem>
        </Suggestion>
      </Example>
      <Example
        title="With Composer"
        description="Selecting a chip fills the composer — the usual empty-state pattern for chat UIs."
        code={composerSnippet}
      >
        <SuggestionDemo client:visible />
      </Example>
    </ExampleGrid>

    <h2>Playground</h2>
    <p>Toggle every adjustable prop and watch the component — and the code — update live.</p>
    <SuggestionPlayground client:visible />

    <h2>Props</h2>
    <div class="docs-table-scroll"><table class="docs-table">
      <caption>Props for Suggestion.</caption>
      <thead><tr><th scope="col">Prop</th><th scope="col">Type</th><th scope="col">Default</th></tr></thead>
      <tbody>
        <tr><td><code>label</code></td><td>string</td><td>"Suggestions"</td></tr>
        <tr><td><code>disabled</code></td><td>boolean</td><td>false</td></tr>
        <tr><td><code>children</code></td><td>ReactNode (SuggestionItem)</td><td>—</td></tr>
      </tbody>
    </table></div>

    <div class="docs-table-scroll"><table class="docs-table">
      <caption>Props for SuggestionItem.</caption>
      <thead><tr><th scope="col">Prop</th><th scope="col">Type</th><th scope="col">Default</th></tr></thead>
      <tbody>
        <tr><td><code>value</code></td><td>string</td><td>button text</td></tr>
        <tr><td><code>onSelect</code></td><td>(value: string) =&gt; void</td><td>—</td></tr>
        <tr><td><code>disabled</code></td><td>boolean</td><td>false</td></tr>
        <tr><td><code>children</code></td><td>ReactNode (required)</td><td>—</td></tr>
      </tbody>
    </table></div>

    <h2>Accessibility</h2>
    <ul>
      <li>The list exposes an accessible name via <code>label</code> (<code>aria-label</code> on the <code>&lt;ul&gt;</code>).</li>
      <li>Each chip is a real <code>&lt;button type="button"&gt;</code> — Tab reaches it, Enter/Space activates it, no custom keyboard layer.</li>
      <li>Disabling the list sets <code>pointer-events: none</code> and dims the group; individual items can also be disabled on their own.</li>
    </ul>
  </div>
</BaseLayout>

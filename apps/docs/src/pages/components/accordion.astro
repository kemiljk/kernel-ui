---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocsSidebar from "../../components/DocsSidebar.astro";
import UsageAccordion from "../../components/UsageAccordion.astro";
import AccordionDemo from "../../components/demos/AccordionDemo";
import AccordionPlayground from "../../components/demos/AccordionPlayground";
import ApiTable from "../../components/ApiTable.astro";

interface Props {}

const usageSnippet = `import { Accordion, AccordionItem } from "@kernelui-lib/react";

<Accordion type="single">
  <AccordionItem title="What is Kernel?">
    A component library built on real HTML elements.
  </AccordionItem>
  <AccordionItem title="Is it accessible?">
    Yes, by default, since the browser does most of the work.
  </AccordionItem>
</Accordion>`;

const elementsUsageSnippet = `<script type="module">
  import "@kernelui-lib/elements";
</script>

<kernel-accordion>
  <kernel-accordion-item title="What is Kernel?">
    A component library built on real HTML elements.
  </kernel-accordion-item>
  <kernel-accordion-item title="Is it accessible?">
    Yes, by default, since the browser does most of the work.
  </kernel-accordion-item>
</kernel-accordion>`;
---

<BaseLayout title="Accordion" withSidebar>
  <DocsSidebar slot="sidebar" />
  <div class="docs-prose">
    <h1>Accordion</h1>
    <p>
      Built on <code>&lt;details&gt;</code>/<code>&lt;summary&gt;</code>.
      Expand, collapse, keyboard support, find-in-page, and print all come
      from the browser.
    </p>

    <div class="docs-example" style="flex-direction: column; align-items: stretch;">
      <AccordionDemo client:visible />
    </div>

    <UsageAccordion code={usageSnippet} elementsCode={elementsUsageSnippet} lang="tsx" />

    <h2>Playground</h2>
    <p>Toggle every adjustable prop and watch the component — and the code — update live.</p>
    <AccordionPlayground client:visible />

    <h2>Props</h2>
    <ApiTable slug="accordion" />

    <h2>Accessibility</h2>
    <ul>
      <li><code>type="single"</code> gives every item the same <code>name</code> attribute, so the browser enforces "only one open at a time" natively, no JS coordination needed.</li>
      <li>The height transition is progressive enhancement (<code>::details-content</code>). Browsers without it still open and close correctly, just without the animation.</li>
    </ul>
  </div>
</BaseLayout>

{
  "name": "@kernelui-lib/cli",
  "version": "1.0.5",
  "description": "Integration CLI and MCP server for Kernel UI: install, diagnose, look up exact component APIs, check code, and set up coding agents.",
  "license": "MIT",
  "author": "Karl Koch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kemiljk/kernel-ui.git",
    "directory": "packages/cli"
  },
  "homepage": "https://www.kernelui.com",
  "bugs": "https://github.com/kemiljk/kernel-ui/issues",
  "keywords": [
    "cli",
    "kernel",
    "design-system",
    "react",
    "shadcn",
    "radix",
    "mcp",
    "model-context-protocol",
    "ai",
    "agents",
    "accessibility"
  ],
  "type": "module",
  "bin": {
    "kernel": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "server.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "build": "bun run --cwd ../registry build && bun scripts/bundle-registry.mjs && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "mcpName": "io.github.kemiljk/kernel-ui"
}

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocsSidebar from "../../components/DocsSidebar.astro";
import SliderDemo from "../../components/demos/SliderDemo";
import SliderPlayground from "../../components/demos/SliderPlayground";
import ApiTable from "../../components/ApiTable.astro";

---

<BaseLayout title="Slider" withSidebar>
  <DocsSidebar slot="sidebar" />
  <div class="docs-prose">
    <h1>Slider</h1>
    <p>
      A real <code>&lt;input type="range"&gt;</code>. Dragging, arrow-key
      stepping, Page Up/Down, Home/End, and touch all come from the
      browser. The filled portion of the track has no standardised
      styling API yet, so the fill percentage is computed in JavaScript
      and fed back in as a CSS custom property, that hand-off is the only
      JavaScript involved.
    </p>
    <p>
      The <code>inset</code> variant turns the track itself into a control:
      the same height and corner as a default Button or Tabs list, filled
      with the accent colour and dragged by a slim bar inside the fill. It
      follows the theme's rounding — square at Sharp, a pill at Round — and
      optional <code>startLabel</code>/<code>endLabel</code> captions change
      colour exactly where the fill crosses them.
    </p>

    <div class="docs-example">
      <SliderDemo client:visible />
    </div>

    <h2>Playground</h2>
    <p>Toggle every adjustable prop and watch the component — and the code — update live.</p>
    <SliderPlayground client:visible />

    
    <h2>Props</h2>
    <ApiTable slug="slider" />
  </div>
</BaseLayout>

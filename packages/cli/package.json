{
  "name": "@kernelui-lib/cli",
  "version": "1.0.2",
  "description": "Integration CLI for Kernel UI — install, diagnose, and look up components.",
  "license": "MIT",
  "author": "Karl Koch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kemiljk/kernel-ui.git",
    "directory": "packages/cli"
  },
  "homepage": "https://www.kernelui.com",
  "bugs": "https://github.com/kemiljk/kernel-ui/issues",
  "keywords": [
    "cli",
    "kernel",
    "design-system",
    "react",
    "shadcn",
    "radix"
  ],
  "type": "module",
  "bin": {
    "kernel": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "build": "bun run --cwd ../registry build && bun scripts/bundle-registry.mjs && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  }
}

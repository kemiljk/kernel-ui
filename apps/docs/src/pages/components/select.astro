---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocsSidebar from "../../components/DocsSidebar.astro";
import SelectDemo from "../../components/demos/SelectDemo";
import SelectPlayground from "../../components/demos/SelectPlayground";

---

<BaseLayout title="Select" withSidebar>
  <DocsSidebar slot="sidebar" />
  <div class="docs-prose">
    <h1>Select</h1>
    <p>
      A real <code>&lt;select&gt;</code>. Options, keyboard navigation,
      typeahead, and form behaviour all come from the browser. Supporting
      browsers use a native picker styled with Kernel's existing tokens;
      other browsers keep the styled control and platform picker.
    </p>

    <div class="docs-example">
      <SelectDemo client:visible />
    </div>

    <h2>Playground</h2>
    <p>Toggle every adjustable prop and watch the component — and the code — update live.</p>
    <SelectPlayground client:visible />

    
    <h2>Props</h2>
    <div class="docs-table-scroll"><table class="docs-table">
      <caption>Props for Select.</caption>
      <thead><tr><th scope="col">Prop</th><th scope="col">Type</th><th scope="col">Default</th></tr></thead>
      <tbody>
        <tr><td><code>label</code></td><td>ReactNode (required)</td><td>—</td></tr>
        <tr><td><code>hideLabel</code></td><td>boolean</td><td>false</td></tr>
        <tr><td><code>description</code></td><td>ReactNode</td><td>—</td></tr>
        <tr><td><code>errorMessage</code></td><td>ReactNode</td><td>—</td></tr>
        <tr><td><code>invalid</code></td><td>boolean</td><td>false</td></tr>
      </tbody>
    </table></div>

    <h2>A note on full customisation</h2>
    <p>
      Single dropdowns use <code>appearance: base-select</code> inside a
      feature query that also checks <code>::picker(select)</code> support.
      The existing chevron, colours, and control dimensions stay in place.
      Multiple selects and listboxes retain their existing rendering.
      Keep text in every option so labels, typeahead, and fallback pickers
      work without additional JavaScript.
    </p>
  </div>
</BaseLayout>
